# Приток: сырьё и отчёты разбора — рабочие файлы, не данные продукта.
# Фикстуры (data/inbox/fixtures) в репозитории нужны: на них гоняются тесты.
data/inbox/raw/
data/inbox/triage/
data/inbox/drafts/
# hold НЕ игнорируется: это очередь карточек, ждущих решения человека.
# Она жила в одноразовом контейнере рутины и исчезала вместе с ним — каждый
# день приток находил сделки, складывал их в ящик и выбрасывал ящик.
data/inbox/updates/
# Эстафета approve.py --write -> --consume внутри ОДНОГО прогона рутины;
# не переживать контейнер не обязана (см. docstring consume_pending в
# pipeline/ingest/approve.py) — если её не будет к следующему прогону,
# он просто ничего не подтвердит, а не потеряет решение.
data/inbox/consume_pending.json

# журнал SQLite остаётся после убитого локального сервера — не данные
*.db-journal
# Ответы читателей фактов (цитаты уже лежат в facts.readings карточек)
data/inbox/facts/
# Аудит адреса фактов (12 сентября 2026): партии карточек и сырые findings
# читателей — рабочие входы/выходы одного прогона, не данные продукта.
# Итог аудита — pipeline/audit_field_placement/*.md — в git.
data/inbox/audit/
