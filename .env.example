# Шаблон переменных окружения для боевого запуска «Компаса».
# Скопировать в .env (или задать через панель хостинга) и заполнить своими
# значениями. Ни одна переменная здесь не обязательна для того, чтобы сайт
# ЗАПУСТИЛСЯ — без каждой из них соответствующая функция просто не работает
# (честная деградация, см. main.py/auth.py/notification_service.py), сайт
# не падает и не притворяется, что функция включена.

# --- База данных аккаунтов (вход, подписки, уведомления, комментарии) ---
# Без неё используется локальный файл SQLite (kompas.db) — годится для
# разработки, не для боевого запуска (файл живёт на диске одного процесса).
# Сама база сделок и компаний в SQL не хранится — она читается из
# static/data/*.json и для запуска эта переменная не нужна вовсе.
DATABASE_URL=postgresql://user:password@host:5432/kompas

# --- Куки сессии ---
# true по умолчанию (secure-cookie, требует HTTPS) — трогать не нужно, если
# сайт за HTTPS. Ставить false можно только для локальной разработки по http.
COOKIE_SECURE=true

# --- SMTP (уведомления и недельная сводка; ДЛЯ ВХОДА больше не нужен —
# вход с 2 августа 2026 идёт по email+паролю, без письма) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@kompas.deals

# --- Telegram: автопостинг сделок в канал ---
# Токен один и тот же, что и для личного бота ниже. Бот должен быть добавлен
# в канал АДМИНИСТРАТОРОМ — иначе публикация постов будет падать с ошибкой
# Telegram API, это делается в интерфейсе Telegram, не переменной окружения.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Ограничение на прогон и пауза между постами — по умолчанию безопасны
# (20 сообщений и 1,2с пауза), трогать не обязательно.
TELEGRAM_MAX_SENDS_PER_RUN=20
TELEGRAM_SEND_DELAY_S=1.2
# Релей до Telegram Bot API (Cloudflare Worker вида https://имя.workers.dev).
# ВАЖНО на российском хостинге: прямая связь Timeweb -> api.telegram.org
# нестабильна — в соседнем проекте владельца («Автопост», тот же Timeweb)
# замерено ~32% отказов на попытку соединения. Воркер прозрачно пробрасывает
# /bot<токен>/<метод> и к конкретному боту не привязан, поэтому один и тот же
# адрес годится для обоих проектов. Пусто = прямой api.telegram.org.
TELEGRAM_API_BASE=

# --- Telegram: личные уведомления (бот пишет пользователю в директ) ---
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- ИИ-ассистент (DeepSeek через Yandex AI Studio) ---
# Без обоих ключей ассистент отвечает локальным fallback, /health отдаёт
# "ai": false — сайт и данные при этом работают как обычно.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=deepseek-v4-flash/latest

# --- ЕГРЮЛ / БФО (пайплайн, не сам сайт) ---
API_FNS_KEY=
